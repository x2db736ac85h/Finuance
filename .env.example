# Copy to .env for local development. DEV-ONLY passwords — never reuse them anywhere else.

# Postgres superuser (bootstrap only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-only

# Finuance roles created by deploy/db/bootstrap.sql
FINUANCE_OWNER_PASSWORD=owner-dev-only
FINUANCE_APP_PASSWORD=app-dev-only
FINUANCE_DB_PORT=5432

# App configuration (read from Phase 2 on; see docs/PLAN.md §3.5)
FINUANCE_ENV=dev
FINUANCE_HTTP_ADDR=:8080
FINUANCE_ADMIN_ADDR=:9090
FINUANCE_PUBLIC_ORIGIN=http://localhost:8000
FINUANCE_DATABASE_URL=postgres://finuance_app:app-dev-only@localhost:5432/finuance?sslmode=disable
FINUANCE_MIGRATE_DATABASE_URL=postgres://finuance_owner:owner-dev-only@localhost:5432/finuance?sslmode=disable
FINUANCE_COOKIE_SECURE=false
# Without these two the binary runs as a production instance: sign-up off, no profiling endpoints.
FINUANCE_ALLOW_SIGNUP=true
FINUANCE_PPROF=true
FINUANCE_LOG_LEVEL=debug

# Assistant (Phase 13, docs/assistant.md). Either one server …
# FINUANCE_AI_BASE_URL=http://localhost:1234/v1
# FINUANCE_AI_API=openai
# FINUANCE_AI_DEFAULT_MODEL=
# … or several named connections, local and cloud:
# FINUANCE_AI_CONNECTIONS_FILE=./deploy/assistant/connections.example.json
# Seals the API keys of connections added in Administration → Assistant (openssl rand -base64 32):
# FINUANCE_INSTANCE_KEY=

# Administration → Developer (docs/admin.md): build, source and links to the tools, administrators
# only. Off by default; refused together with FINUANCE_DEMO_MODE.
# FINUANCE_DEVELOPER_MODE=true
# FINUANCE_DEVELOPER_LINKS_FILE=./deploy/developer/links.example.json   # make dev-api
# FINUANCE_DEVELOPER_LINKS_FILE=/etc/finuance/developer/links.example.json   # make up (mounted)
