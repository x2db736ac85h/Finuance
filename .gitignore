*.swp

# tools/perf/*.mjs write their results next to where they run
/perf-duplicates.json
/perf-grid.json
/perf-overview.json

# tools/rehearsal.sh work directory (kubeconfig, throwaway CA and keys, k6 output)
/.rehearsal/
loadtest/results/
# the animals' seed and passwords for k6 (make loadtest-seed)
loadtest/.sim-seed
loadtest/users.json
zap-reports/

# written by scripts/query-smoke.sh (an export to open in a spreadsheet)
query-smoke-export.csv

# Claude Code: per-user settings (local paths, permissions)
.claude/settings.local.json
# the lab's secrets (make sim-up)
.env.lab

# Terraform's working directory and local state (deploy/terraform; the lock file is committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars

