[{"name":"search_transactions","description":"List individual transactions that match filters. Returns the matched count, totals and up to `limit` rows.","parameters":{"type":"object","properties":{"query":{"type":"string","description":"Words that must ALL appear somewhere in the transaction (payee, title, address, category…). Case- and accent-insensitive."},"payee":{"type":"string","description":"Text contained in the payee/merchant name"},"category":{"type":"string","description":"Category name or part of it"},"group":{"type":"string","description":"Name of a user-defined transaction group (e.g. a trip)"},"date_from":{"type":"string","description":"Inclusive start date, YYYY-MM-DD"},"date_to":{"type":"string","description":"Inclusive end date, YYYY-MM-DD"},"type":{"type":"string","enum":["expense","income","any"],"description":"expense = money spent (negative amounts), income = money received"},"min_amount":{"type":"number","description":"Minimum absolute amount"},"max_amount":{"type":"number","description":"Maximum absolute amount"},"sort":{"type":"string","enum":["date_desc","date_asc","amount_desc","amount_asc"]},"limit":{"type":"integer","description":"Rows to return (default 25)"}}}},{"name":"aggregate_transactions","description":"Counts and totals (spent, income, net) grouped by a dimension. Use for \"how much\", \"how many\", trends, rankings and comparisons.","parameters":{"type":"object","properties":{"group_by":{"type":"string","enum":["none","category","payee","month","week","day","weekday","type","group","account"]},"query":{"type":"string","description":"Words that must ALL appear somewhere in the transaction (payee, title, address, category…). Case- and accent-insensitive."},"payee":{"type":"string","description":"Text contained in the payee/merchant name"},"category":{"type":"string","description":"Category name or part of it"},"group":{"type":"string","description":"Name of a user-defined transaction group (e.g. a trip)"},"date_from":{"type":"string","description":"Inclusive start date, YYYY-MM-DD"},"date_to":{"type":"string","description":"Inclusive end date, YYYY-MM-DD"},"type":{"type":"string","enum":["expense","income","any"],"description":"expense = money spent (negative amounts), income = money received"},"min_amount":{"type":"number","description":"Minimum absolute amount"},"max_amount":{"type":"number","description":"Maximum absolute amount"},"top":{"type":"integer","description":"Max groups to return"}},"required":["group_by"]}},{"name":"find_values","description":"Distinct payee, category or group names containing some text, with counts. Use it to resolve how a merchant or category is spelled in the data.","parameters":{"type":"object","properties":{"field":{"type":"string","enum":["payee","category","group"]},"query":{"type":"string"}},"required":["field"]}}]