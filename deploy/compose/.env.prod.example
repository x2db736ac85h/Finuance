# Copy to .env next to compose.prod.yaml and set every value. Use long random passwords, e.g.
#   openssl rand -base64 24
FINUANCE_VERSION=0.1.0
# The URL people open (the CSRF check compares it); http://localhost:8000 to try it on this machine
FINUANCE_PUBLIC_ORIGIN=https://finance.example.com

POSTGRES_PASSWORD=change-me
FINUANCE_OWNER_PASSWORD=change-me-too
FINUANCE_APP_PASSWORD=change-me-as-well

# Optional
# FINUANCE_WEB_BIND=0.0.0.0        # listen on every interface (default 127.0.0.1). Cookies are
#                                  # secure-only: browse via https, or http://localhost (an ssh tunnel)
# FINUANCE_WEB_PORT=8000
# FINUANCE_ALLOW_SIGNUP=true       # default false: create users with `finuance admin create-user`
# FINUANCE_DEVELOPER_MODE=true     # default false: build information for administrators (docs/admin.md)
# FINUANCE_AI_BASE_URL=http://lmstudio.lan:1234/v1   # the assistant (docs/assistant.md)
# FINUANCE_INSTANCE_KEY=                                # seals API keys entered in the admin panel (openssl rand -base64 32)
