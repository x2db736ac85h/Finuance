# syntax=docker/dockerfile:1.7
# Backend image: one static binary (serve, worker, migrate, healthcheck) on distroless.
# Build from the repository root:  make images   (or docker build -f deploy/docker/Dockerfile.backend .)

# The build stages run on the build machine's platform and cross-compile (release images for amd64
# and arm64 need no emulation); only the final stage is per platform.
FROM --platform=$BUILDPLATFORM golang:1.27.3-trixie@sha256:1896654cfc5c2b5ad74c07f29cb36f5d2d1cbed42e3054070fbfe444e521e83c AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
# Modules come from the cache mount; a vendor/ directory, when present in the build context, is used
# instead (offline builds).
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=bind,source=backend,target=/ctx \
    if [ ! -d /ctx/vendor ]; then go mod download; fi
COPY backend/ ./
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
      -o /out/finuance ./cmd/finuance

# The mock model server for the Compose ai-mock profile and E2E (target llmmock). It is a separate
# target, so the production image below never contains it.
FROM build AS llmmock-build
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags "-s -w" -o /out/llmmock ./cmd/llmmock

FROM gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087 AS llmmock
COPY --from=llmmock-build /out/llmmock /llmmock
USER nonroot:nonroot
EXPOSE 11434
ENTRYPOINT ["/llmmock"]

FROM gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087
LABEL org.opencontainers.image.source="https://github.com/x2db736ac85h/Finuance" \
      org.opencontainers.image.title="finuance-backend" \
      org.opencontainers.image.licenses="MIT"
COPY --from=build /out/finuance /finuance
USER nonroot:nonroot
EXPOSE 8080 9090
# No shell in distroless: the container healthcheck runs `finuance healthcheck`.
HEALTHCHECK --interval=10s --timeout=4s --start-period=5s --retries=3 CMD ["/finuance", "healthcheck"]
ENTRYPOINT ["/finuance"]
CMD ["serve"]
