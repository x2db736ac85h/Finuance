    {
      "id": 14,
      "type": "timeseries",
      "title": "Errors in the browser by kind",
      "description": "error and unhandled_rejection: the web app's own code failed. render: a screen could not be drawn. csp: the content security policy blocked something.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(finuance_client_errors_total{job=\"finuance-api\",namespace=\"$namespace\"}[15m]))",
