      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{job=\"finuance-api\",namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
