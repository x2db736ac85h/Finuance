      "title": "Database",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Transactions a second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m])) or sum(rate(cnpg_pg_stat_database_xact_commit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m]))",
          "legendFormat": "committed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m])) or sum(rate(cnpg_pg_stat_database_xact_rollback{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m]))",
          "legendFormat": "rolled back",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
