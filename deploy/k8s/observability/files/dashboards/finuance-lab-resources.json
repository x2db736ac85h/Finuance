      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=~\"$namespace|finuance-sim\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
