          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cache hits",
      "description": "Blocks found in shared buffers rather than read from disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(pg_stat_database_blks_hit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m])) or sum(rate(cnpg_pg_stat_database_blks_hit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m]))) / ((sum(rate(pg_stat_database_blks_hit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m])) or sum(rate(cnpg_pg_stat_database_blks_hit{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m]))) + (sum(rate(pg_stat_database_blks_read{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m])) or sum(rate(cnpg_pg_stat_database_blks_read{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}[1m]))))",
          "legendFormat": "hits",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(pg_stat_database_numbackends{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"}) or sum(cnpg_backends_total{job=\"finuance-db\",namespace=\"$namespace\",datname=\"finuance\"})",
          "legendFormat": "to the database",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (pgxpool_acquired_conns{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"})",
          "legendFormat": "in use {{job}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 39
      },
