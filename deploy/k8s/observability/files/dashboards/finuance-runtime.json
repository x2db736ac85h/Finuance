        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Connection pool (pgxpool)",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Connections in use / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, pod) (pgxpool_acquired_conns{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"})",
          "legendFormat": "in use {{job}} {{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, pod) (pgxpool_max_conns{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"})",
          "legendFormat": "max {{job}} {{pod}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Average wait for a connection",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (job, pod) (rate(pgxpool_acquire_duration_seconds_total{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"}[5m])) or vector(0)) / (sum by (job, pod) (rate(pgxpool_acquire_total{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{job}} {{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
