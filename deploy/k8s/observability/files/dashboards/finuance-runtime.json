        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, pod) (go_memstats_heap_inuse_bytes{job=~\"finuance-(api|worker)\",namespace=\"$namespace\"})",
          "legendFormat": "{{job}} {{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
