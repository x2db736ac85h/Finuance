{{- /* The daily digest's text (docs/SLO.md "Daily digest"), a Prometheus alert template: the
       chart replaces the __UPPER__ placeholders. Figures come from the finuance:digest_24h
       recording rules or straight from the metrics. The recordings are refreshed every 10 minutes,
       longer than an instant query looks back (5 minutes), so they are read with last_over_time, as
       of the previous evaluation (its rule group may not have run yet at this one). */ -}}
{{- define "v" }}{{ if eq .Labels.unit "ratio" }}{{ .Value | humanizePercentage }}{{ else if eq .Labels.unit "seconds" }}{{ .Value | humanizeDuration }}{{ else if eq .Labels.unit "bytes" }}{{ if ge .Value 0.0 }}+{{ end }}{{ .Value | humanize1024 }}B{{ else if eq .Labels.unit "rate" }}{{ printf "%.2f requests/s" .Value }}{{ else }}{{ .Value | humanize }}{{ end }}{{ end }}
{{- define "name" }}{{ if eq . "availability" }}Availability{{ else if eq . "latency_p95" }}p95 latency{{ else if eq . "latency_within_slo" }}Requests within 300 ms{{ else if eq . "requests" }}Requests{{ else if eq . "peak_rate" }}Peak traffic{{ else if eq . "errors_5xx" }}Server errors{{ else if eq . "imports" }}Imports{{ else if eq . "imports_failed" }}Failed imports{{ else if eq . "jobs_failed" }}Failed jobs{{ else if eq . "assistant_runs" }}Assistant runs{{ else if eq . "database_growth" }}Database growth{{ else if eq . "restarts" }}Restarts{{ else if eq . "cpu_peak" }}CPU peak{{ else if eq . "memory_peak" }}Memory peak{{ else if eq . "ingress_5xx" }}Errors at the ingress{{ else }}{{ . }}{{ end }}{{ end }}
