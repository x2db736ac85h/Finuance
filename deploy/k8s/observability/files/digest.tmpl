  {{ template "name" .Labels.indicator }}: {{ with query (printf "last_over_time(finuance:digest_24h{indicator=%q}[15m] offset __EVAL__s)" .Labels.indicator) }}{{ template "v" (first .) }}{{ end }}, usually {{ with query (printf "last_over_time(finuance:digest_24h:avg7d{indicator=%q}[15m] offset __EVAL__s)" .Labels.indicator) }}{{ template "v" (first .) }}{{ end }}{{ with query (printf "100 * (last_over_time(finuance:digest_24h{indicator=%q}[15m] offset __EVAL__s) - on (indicator, unit) last_over_time(finuance:digest_24h:avg7d[15m] offset __EVAL__s)) / on (indicator, unit) abs(last_over_time(finuance:digest_24h:avg7d[15m] offset __EVAL__s) != 0)" .Labels.indicator) }} ({{ . | first | value | printf "%+.0f" }}%){{ end }}
