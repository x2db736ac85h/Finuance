  Failed jobs           {{ template "ind" "jobs_failed" }}{{ range sortByLabel "kind" (query `last_over_time(finuance:digest_24h_failed_jobs:by_kind[15m] offset __EVAL__s) >= 0.5`) }} · {{ .Labels.kind }} {{ printf "%.0f" .Value }}{{ end }}
  Assistant runs        {{ template "ind" "assistant_runs" }}
{{- if eq "__DATABASE__" "true" }}

DATABASE
  Size                  {{ with query `max(cnpg_pg_database_size_bytes{job="finuance-db",namespace="__NS__",datname="finuance"})` }}{{ . | first | value | humanize1024 }}B{{ else }}no data{{ end }} ({{ template "ind" "database_growth" }} in 24 hours)
  Replication lag       at most {{ with query `max(max_over_time(cnpg_pg_replication_lag{job="finuance-db",namespace="__NS__"}[24h]))` }}{{ . | first | value | humanizeDuration }}{{ else }}no data{{ end }}
  WAL archiving         last archived {{ with query `min(cnpg_pg_stat_archiver_seconds_since_last_archival{job="finuance-db",namespace="__NS__"})` }}{{ . | first | value | humanizeDuration }} ago{{ else }}no data{{ end }}{{ with query `sum(increase(cnpg_pg_stat_archiver_failed_count{job="finuance-db",namespace="__NS__"}[24h])) >= 0.5` }}, {{ . | first | value | printf "%.0f" }} failed attempts{{ end }}
