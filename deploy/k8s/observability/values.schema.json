{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["appNamespace", "dashboards", "rules", "alerting"],
  "properties": {
    "appNamespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "folder": { "type": "string" },
        "folderAnnotation": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "database": { "type": "boolean" },
        "backups": { "type": "boolean" },
        "kubernetes": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traefik": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespace", "selector", "port"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
            "selector": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
            "port": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "alerting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "to": { "type": "string" },
            "from": { "type": "string" },
            "smarthost": { "type": "string", "pattern": "^$|^[^:/\\s]+:[0-9]+$" },
            "authUsername": { "type": "string" },
            "passwordSecret": {
              "type": "object",
              "required": ["name", "key"],
              "properties": { "name": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 } }
            },
            "requireTLS": { "type": "boolean" }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severities": { "type": "array", "items": { "type": "string", "enum": ["critical", "warning", "info"] } }
          }
        },
        "heartbeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "weekday", "startTime", "endTime"],
          "properties": {
            "enabled": { "type": "boolean" },
            "weekday": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
            "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$" }
          }
        },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
