{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":pinAllExceptPeerDependencies"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Major updates need an explicit review",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "go modules (non-major)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "npm (non-major)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "docker images",
      "matchManagers": ["docker-compose", "dockerfile"]
    },
    {
      "description": "Postgres majors change the data layout; upgrade deliberately",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "gomod": { "postUpdateOptions": ["gomodTidy"] }
}
